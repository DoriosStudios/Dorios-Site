{
  "name": "website",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "refresh:github-stats": "node scripts/refresh-github-release-stats.mjs",
    "refresh:curseforge-stats": "node scripts/refresh-curseforge-stats.mjs",
    "generate:utilitycraft-machine-recipes": "node scripts/extract-utilitycraft-processing-recipes.mjs",
    "generate:vanilla-assets": "node scripts/generate-vanilla-asset-index.mjs",
    "generate:social-previews": "node scripts/generate-social-previews.mjs",
    "prebuild": "npm run refresh:github-stats && npm run refresh:curseforge-stats && npm run generate:utilitycraft-machine-recipes && npm run generate:vanilla-assets && npm run generate:social-previews",
    "prestart": "npm run refresh:github-stats && npm run refresh:curseforge-stats && npm run generate:utilitycraft-machine-recipes && npm run generate:vanilla-assets && npm run generate:social-previews",
    "start": "docusaurus start",
    "build": "npm run validate:catalog && docusaurus build",
    "validate:catalog": "node scripts/validate-project-catalog.mjs",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids"
  },
  "dependencies": {
    "@docusaurus/core": "3.9.1",
    "@docusaurus/preset-classic": "3.9.1",
    "@docusaurus/theme-search-algolia": "^3.9.1",
    "@easyops-cn/docusaurus-search-local": "^0.52.1",
    "@fontsource-variable/league-spartan": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-responsive-carousel": "^3.2.23"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.9.1",
    "@docusaurus/types": "3.9.1",
    "sharp": "^0.34.5"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  }
}
