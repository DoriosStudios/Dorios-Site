{
  "name": "website",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "optimize:brand-images": "node scripts/optimize-brand-images.mjs",
    "test:performance": "node --test scripts/navigation-performance.test.mjs",
    "test:wiki": "node --test scripts/wiki-editorial.test.cjs scripts/wiki-redesign.test.cjs scripts/wiki-ui-icons.test.mjs plugins/addon-wiki-routes/route-data.test.js scripts/machine-catalog.test.cjs scripts/wiki-search.test.mjs",
    "benchmark:navigation": "node scripts/benchmark-navigation.mjs",
    "sync:wiki": "python scripts/sync-project-wikis.py",
    "generate:bedrock-renders": "node scripts/generate-bedrock-renders.mjs",
    "test:bedrock-renders": "node --test scripts/bedrock-renderer.test.mjs",
    "test:site-features": "node --test scripts/project-statistics.test.mjs scripts/atelier-wiki.test.mjs scripts/navigation-performance.test.mjs ../services/download-counter/worker.test.mjs",
    "docusaurus": "docusaurus",
    "refresh:github-stats": "node scripts/refresh-github-release-stats.mjs",
    "refresh:curseforge-stats": "node scripts/refresh-curseforge-stats.mjs",
    "generate:utilitycraft-machine-recipes": "node scripts/extract-utilitycraft-processing-recipes.mjs",
    "generate:ascendant-documentation": "node scripts/generate-ascendant-documentation-profiles.mjs",
    "generate:ascendant-machine-grid": "node scripts/generate-ascendant-machine-grid.mjs",
    "generate:shared-item-documentation": "node scripts/generate-shared-item-documentation-profiles.mjs",
    "generate:better-smelters-wiki": "node scripts/generate-better-smelters-wiki.mjs",
    "generate:wiki-locales": "node scripts/generate-wiki-localized-names.mjs",
    "apply:site-translations": "node scripts/apply-site-translations.mjs",
    "generate:ascendant-glyph-icons": "node scripts/sync-ascendant-glyph-icons.mjs",
    "generate:wiki-ui-icons": "node scripts/sync-ascendant-glyph-icons.mjs",
    "validate:machine-recipes": "node scripts/validate-machine-recipe-catalog.mjs",
    "generate:vanilla-assets": "node scripts/generate-vanilla-asset-index.mjs",
    "generate:social-previews": "node scripts/generate-social-previews.mjs",
    "prebuild": "npm run prepare:atelier-builder && npm run refresh:github-stats && npm run refresh:curseforge-stats && npm run generate:utilitycraft-machine-recipes && npm run generate:ascendant-documentation && npm run generate:ascendant-machine-grid && npm run generate:shared-item-documentation && npm run generate:ascendant-glyph-icons && npm run prepare:wiki-visuals && npm run generate:vanilla-assets && npm run generate:social-previews",
    "start": "node scripts/start-dev.mjs",
    "build": "npm run validate:catalog && npm run validate:machine-recipes && node scripts/build-site.mjs",
    "validate:catalog": "node scripts/validate-project-catalog.mjs",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "prepare:atelier-builder": "node scripts/prepare-atelier-builder.mjs",
    "prepare:dev": "npm run prepare:atelier-builder && npm run refresh:github-stats && npm run refresh:curseforge-stats && npm run generate:utilitycraft-machine-recipes && npm run generate:ascendant-documentation && npm run generate:ascendant-machine-grid && npm run generate:shared-item-documentation && npm run generate:ascendant-glyph-icons && npm run prepare:wiki-visuals && npm run generate:vanilla-assets && npm run generate:social-previews",
    "collect:vanilla-assets": "node scripts/collect-vanilla-assets.mjs",
    "generate:vanilla-faces": "node scripts/extract-vanilla-faces.mjs",
    "generate:entity-renders": "node scripts/generate-bedrock-entity-renders.mjs",
    "generate:entity-faces": "node scripts/generate-bedrock-entity-renders.mjs --format face",
    "generate:entity-portraits": "node scripts/generate-bedrock-entity-renders.mjs --format portrait",
    "prepare:wiki-visuals": "node scripts/prepare-wiki-visuals.mjs",
    "validate:visual-coverage": "node scripts/prepare-wiki-visuals.mjs --coverage",
    "test:entity-renders": "node --test scripts/bedrock-entity.test.mjs",
    "test:vanilla-assets": "node --test scripts/vanilla-assets.test.mjs",
    "test:visual-pipeline": "node --test scripts/wiki-visuals.test.mjs"
  },
  "dependencies": {
    "@docusaurus/core": "3.9.1",
    "@docusaurus/preset-classic": "3.9.1",
    "@docusaurus/theme-search-algolia": "^3.9.1",
    "@easyops-cn/docusaurus-search-local": "^0.52.1",
    "@fontsource-variable/league-spartan": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@mdx-js/react": "^3.0.0",
    "@tabler/icons-react": "^3.46.0",
    "clsx": "^2.0.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-responsive-carousel": "^3.2.23"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.9.1",
    "@docusaurus/types": "3.9.1",
    "baseline-browser-mapping": "^2.11.39",
    "sharp": "^0.34.5"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  }
}

